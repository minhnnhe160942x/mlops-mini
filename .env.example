# Copy to .env before `docker compose up`.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MODEL_NAME=breast-cancer-classifier
MODEL_ALIAS=champion
# Leave empty to follow the champion alias. Set a registry version number to
# pin that exact model instead - that is how you upgrade or roll back serving.
MODEL_VERSION=
DRIFT_PSI_THRESHOLD=0.2
# Validation gate: fail the run if more than this fraction of rows is bad.
MAX_BAD_FRACTION=0.05
# Hold-out share used by the split step.
TEST_FRACTION=0.20
AIRFLOW_SECRET_KEY=mlops-mini-dev-secret
AIRFLOW_JWT_SECRET=mlops-mini-dev-jwt-secret
# Host ports - change these if something already owns the default.
AIRFLOW_PORT=18080
MLFLOW_PORT=15010
API_PORT=18011
